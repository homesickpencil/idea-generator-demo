# Copy to .env for local dev, or set these as Environment Variables in the Vercel project.

# --- LLM (provider-agnostic; any OpenAI-compatible endpoint) ---
LLM_API_KEY=                                   # secret. Server-side ONLY, never in the frontend.
LLM_BASE_URL=https://openrouter.ai/api/v1      # OpenRouter by default; swap for any provider.
LLM_MODEL=                                      # an OpenRouter model slug, e.g. a cheap open model.

# --- Database (Neon Postgres) ---
DATABASE_URL=                                   # Neon POOLED connection string.

# --- Frontend (the web-ui URL: used for CORS AND the bot's /ideate link-back) ---
FRONTEND_URL=http://localhost:5173              # the deployed web-ui URL (Vite dev server locally).

# --- Telegram bot (runs inside this same backend deployment) ---
TELEGRAM_BOT_TOKEN=                             # from @BotFather. Leave blank to disable the bot.
